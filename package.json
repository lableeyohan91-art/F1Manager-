{
  "name": "f1manager",
  "private": true,
  "version": "0.1.0",
  "description": "Simulation de management d'écurie de course (nom de travail)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "apercu": "vite preview",
    "typecheck": "tsc --noEmit",
    "purete": "node tools/verifier-purete.mjs",
    "test": "vitest run",
    "verifier": "npm run typecheck && npm run purete && npm run test",
    "simuler": "tsx src/cli/simuler.ts",
    "rejouer": "tsx src/cli/rejouer.ts",
    "equilibrage": "tsx src/cli/equilibrage.ts",
    "dilemmes": "tsx src/cli/dilemmes.ts",
    "campagne": "tsx src/cli/campagne.ts",
    "finances": "tsx tools/inspecter-finances.ts",
    "statistiques-finances": "tsx tools/statistiques-finances.ts",
    "persistance": "tsx tools/persistance-classements.mts .",
    "demographie": "tsx tools/demographie.mts",
    "dominations": "tsx tools/diagnostic-dominations.mts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
